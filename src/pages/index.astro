---
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/organisms/PortfolioHero.astro";
import SiteHeader from "../components/organisms/SiteHeader.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const assetPath = (path: string) => `${basePath}/${path}`;
---

<Layout>
  <SiteHeader />

  <main>
    <PortfolioHero />

    <section id="about" class="about">
    <article class="about-me">
      <aside class="about-text-title">
        <h2>David León</h2>
        <h5>software developer</h5>
      </aside>
      <aside class="about-content">
        <div>
          <p class="">
            Desarrollador frontend y diseñador completamente autodidacta, entusiasta de la tecnología y aprendizaje.
          </p>
          <p class="">
            Puedo colaborarte en el desarrollo de acuerdo a tus necesidades, haciendo el uso de frameworks o codigo con JS, HTML, CSS; páginas interactivas o estáticas, código reutilizable y escalable.
          </p>
          <p>
            ¿Deseas que te acompañe en la realización de tu proyecto?.  Me encuentro con las capacidades para colaborar con los tus intereses propuestos.
          </p>
          <div class="hyperlink-btn-container">
            <a class="hyperlink-btn" href="https://cvapp.es/r/vmCQvWX9h" target="_blank" rel="noopener">MIRA MI CV</a>
          </div>
        </div>
        <div class="about-img-filling" style="margin: 2rem 0; margin-left: 2rem ">
          <img src={assetPath("image/about_filling.svg")} alt="about filling ">
        </div>
      </aside>      
    </article>
    <article class="about-tech">
      <h2 class="">Mis Habilidades</h2>
      <div class="container-icon-tech">
        <figure>
          <img class="tech-icon" src={assetPath("image/logo_Python.svg")} alt="Python">
        </figure>
        <figure>
          <img class="tech-icon" src={assetPath("image/logo_JavaScript.svg")} alt="JavaScript">
        </figure>
        <figure>
          <img class="tech-icon" src={assetPath("image/logo_React.svg")} alt="React">
        </figure>
        <figure>
          <img class="tech-icon" src={assetPath("image/logo_HTML.svg")} alt="Html">
        </figure>
        <figure>
          <img class="tech-icon" src={assetPath("image/logo_CSS.svg")} alt="Css">
        </figure>
      </div>
    </article>
  </section>

  <section id="objetivo" class="objetivo">
    <h2>Objetivo</h2>
    <p>
      Como AI-Engineer, implemento soluciones de inteligencia artificial: modelos de ML, sistemas de NLP, chatbots inteligentes, análisis predictivo e integración de LLMs para optimizar procesos empresariales.
    </p>
  </section>

  <section id="perfil" class="perfil">
    <h2>Perfil Profesional</h2>
    <h3 class="perfil-name">Jesús David León Chito</h3>
    <h4 class="perfil-role">AI Engineer / AI Developer</h4>
    <p>
      IA Agéntica, Tool Calling, razonamiento y ejecución de múltiples pasos, arquitecturas Planner/Executor/Validator, RAG, Prompt Engineering, memoria y gestión de contexto, evaluación y testing de LLMs, detección de alucinaciones, monitorización y detección de Drift. Cuento con experiencia en APIs y servicios backend, despliegue en producción sobre AWS/Azure/GCP, herramientas de automatización como UiPath, Power Automate y RPA, análisis de datos con Power BI, y administración de bases de datos como SQL Server y Oracle. Además, sólidas competencias en DevOps, operaciones, liderazgo y mentoría.
    </p>
  </section>

  <section  id="service" class="service">
    <div class="service-content">
      <h2>Servicios</h2>
        <div class="service-item-tech">
          <article class="service-container">
            <svg class="service-elemet-logo" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
