---
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/organisms/PortfolioHero.astro";
import SiteHeader from "../components/organisms/SiteHeader.astro";
import Experience from "../modules/profile/components/Experience.astro";
import ExpectedTechnicalSkills from "../modules/profile/components/ExpectedTechnicalSkills.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const assetPath = (path: string) => `${basePath}/${path}`;
---

<Layout>
  <SiteHeader />

  <main>
    <PortfolioHero />
    <ExpectedTechnicalSkills />
    <Experience />

  <section  id="service" class="service">
    <div class="service-content">
      <h2>Servicios</h2>
        <div class="service-item-tech">
          <article class="service-container">
            <svg class="service-elemet-logo" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path
                d="M20,3H4C2.897,3,2,3.897,2,5v14c0,1.103,0.897,2,2,2h16c1.103,0,2-0.897,2-2V5C22,3.897,21.103,3,20,3z M4,19V7h16 l0.002,12H4z" />
              <path
                d="M9.293 9.293L5.586 13 9.293 16.707 10.707 15.293 8.414 13 10.707 10.707zM14.707 9.293L13.293 10.707 15.586 13 13.293 15.293 14.707 16.707 18.414 13z" />
            </svg>
            <aside class="service-elemet-text">
              <h2>MCP</h2>
              <p>
                Diseño e integración de servidores MCP para conectar agentes de IA con herramientas, datos y sistemas empresariales.
              </p>
            </aside>
          </article>
          <article class="service-container">
            <svg class="service-elemet-logo" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path
                d="M20,3H7C5.897,3,5,3.897,5,5v2H4C2.897,7,2,7.897,2,9v10c0,1.103,0.897,2,2,2h6c1.103,0,2-0.897,2-2h8c1.103,0,2-0.897,2-2 V5C22,3.897,21.103,3,20,3z M6,9h4l-0.003,9H4V9H6z M12,17V9c0-1.103-0.897-2-2-2H7V5h11v12H12z" />
            </svg>
            <aside class="service-elemet-text">
              <h2>Agentes inteligentes</h2>
              <p>
                Desarrollo de agentes con tool calling, memoria y gestión de contexto para ejecutar tareas de varios pasos.
              </p>
            </aside>
          </article>
        </div>
        <div class="service-item-tech">
          <article class="service-container">
            <svg class="service-elemet-logo" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <circle cx="12" cy="20" r="2" />
              <circle cx="12" cy="4" r="2" />
              <circle cx="6.343" cy="17.657" r="2" />
              <circle cx="17.657" cy="6.343" r="2" />
              <circle cx="4" cy="12" r="2.001" />
              <circle cx="20" cy="12" r="2" />
              <circle cx="6.343" cy="6.344" r="2" />
              <circle cx="17.657" cy="17.658" r="2" />
            </svg>
            <aside class="service-elemet-text">
              <h2>RAG</h2>
              <p>Implementación de recuperación aumentada para generar respuestas basadas en conocimiento relevante y verificable.</p>
            </aside>
          </article>
          <article class="service-container">
            <svg class="service-elemet-logo" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path
                d="M10,18c1.846,0,3.543-0.635,4.897-1.688l4.396,4.396l1.414-1.414l-4.396-4.396C17.365,13.543,18,11.846,18,10 c0-4.411-3.589-8-8-8s-8,3.589-8,8S5.589,18,10,18z M10,4c3.309,0,6,2.691,6,6s-2.691,6-6,6s-6-2.691-6-6S6.691,4,10,4z" />
              <path
                d="M11.412,8.586C11.791,8.966,12,9.468,12,10h2c0-1.065-0.416-2.069-1.174-2.828c-1.514-1.512-4.139-1.512-5.652,0 l1.412,1.416C9.346,7.83,10.656,7.832,11.412,8.586z" />
            </svg>
            <aside class="service-elemet-text">
              <h2>Sistemas multiagente</h2>
              <p>Orquestación de equipos de agentes con patrones Planner, Executor y Validator para flujos controlados y trazables.</p>
            </aside>
          </article>
        </div>
    </div>
  </section>

  <section id="trabajos" class="trabajos" hidden aria-hidden="true">
    <h2>Trabajos</h2>
    <div class="trabajos-container">
      <article class="trabajo-card">
        <div class="trabajo-image">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="trabajo-content">
          <h3>AI Developer</h3>
          <p>Desarrollo de soluciones de inteligencia artificial y modelos de aprendizaje automático para optimización de procesos empresariales.</p>
        </div>
      </article>
      <article class="trabajo-card">
        <div class="trabajo-image">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
        </div>
        <div class="trabajo-content">
          <h3>ML Engineer</h3>
          <p>Implementación y despliegue de modelos de machine learning en producción con infraestructura escalable.</p>
        </div>
      </article>
      <article class="trabajo-card">
        <div class="trabajo-image">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <div class="trabajo-content">
          <h3>Data Analyst</h3>
          <p>Análisis y visualización de datos para la toma de decisiones estratégicas basadas en evidencia.</p>
        </div>
      </article>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="main-contact-container" style={`--card-image: url("${assetPath("image/content_card_bkg.svg")}")`}>
      <h2 class="contact-title">¿Interesado?</h2>
      <aside class="contact-tool">
        <article class="content-card">
          <h3>Contactos</h3>
          <aside class="element-card">
            <a href="tel:3234105717">
              <svg viewBox="0 0 33 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
